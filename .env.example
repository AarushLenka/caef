# Copy to .env and fill in. Every safety-relevant tunable lives here (TDD.md §6).

# --- Storage ---
# Supabase: Project Settings > Database > Connection string (URI), session pooler.
# Leave unset to fall back to local SQLite (offline tests / E2E).
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# RAG_DB_PATH=caef_rag.db

# --- Agent (LangChain over any OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o
# OpenRouter: https://openrouter.ai/api/v1 | Groq: https://api.groq.com/openai/v1
# Ollama (free/local): http://localhost:11434/v1
# LLM_BASE_URL=

# --- Safety (defaults shown; override only with a documented reason) ---
# MAX_RETRIES=3
# SANDBOX_TIMEOUT_SECONDS=10
# STRIKE_LIMIT=3
# REVERSION_WINDOW_SECONDS=300
# REVERSION_MODE=time            # time | condition | combined  (PRD OQ-1)
# EXTRA_FORBIDDEN_PINS=
